{
    "name": "uv-vscode",
    "displayName": "Practical UV",
    "description": "Practical plugin for handling pyproject.toml generated by uv",
    "publisher": "wizhut",
    "repository": {
        "type": "git",
        "url": "https://github.com/wizhut/uv-vscode"
    },
    "homepage": "https://wizhut.tech/practical-uv",
    "version": "0.2.0",
    "license": "MIT",
    "icon": "icon.png",
    "author": {
        "name": "Vassilios Karakoidas",
        "email": "vassilios.karakoidas@wizhut.tech"
    },
    "engines": {
        "vscode": "^1.125.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:toml",
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "toml",
                "extensions": [
                    ".toml"
                ],
                "aliases": [
                    "TOML",
                    "toml"
                ]
            }
        ],
        "grammars": [
            {
                "language": "toml",
                "scopeName": "source.toml",
                "path": "./syntaxes/toml.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "uv.sync",
                "title": "UV: Sync"
            },
            {
                "command": "uv.add",
                "title": "UV: Add"
            },
            {
                "command": "uv.run",
                "title": "UV: Run"
            },
            {
                "command": "uv.upgradeVersion",
                "title": "UV: Upgrade Version"
            },
            {
                "command": "uv.selectVersion",
                "title": "UV: Select Version to Upgrade To"
            },
            {
                "command": "uv.selectPythonVersion",
                "title": "UV: Select Python Version"
            },
            {
                "command": "uv.showDependencies",
                "title": "UV: Show Dependencies"
            },
            {
                "command": "uv.checkSecurity",
                "title": "UV: Check Dependencies for Security Advisories"
            },
            {
                "command": "uv.convertToUv",
                "title": "UV: Convert requirements.txt to uv project"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "uv.convertToUv",
                    "when": "uv.requirementsActive"
                }
            ]
        },
        "configuration": {
            "title": "Practical UV",
            "properties": {
                "uv.security.enabled": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Check declared dependencies against the [OSV](https://osv.dev) advisory database and report known vulnerabilities as diagnostics.\n\n**Privacy:** when enabled, the names and versions of your declared dependencies are sent to `api.osv.dev`. Only top-level dependencies are checked; the transitive tree in `uv.lock` is used solely to resolve exact versions and is never sent."
                },
                "uv.security.includeRangeFindings": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Also report advisories that a dependency's declared range *permits* but that its resolved version may not have. Requires `#uv.security.enabled#`.\n\nThese appear for dependencies with no `uv.lock` entry and no exact pin. They are accurate but noisy — an open constraint like `requests>=2.0` permits every advisory ever published for that package."
                }
            }
        }
    },
    "scripts": {
        "package": "node scripts/package.js",
        "package:vscode": "node scripts/package.js vscode",
        "package:openvsx": "node scripts/package.js openvsx",
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node --test out/test/*.test.js"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@types/vscode": "^1.125.0",
        "@vscode/vsce": "^3.9.2",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@iarna/toml": "^2.2.5"
    }
}
